# Required: create a Telegram bot with @BotFather and paste its token here
TELEGRAM_BOT_TOKEN=

# Required: your Telegram numeric chat ID
TELEGRAM_CHAT_ID=

# Optional: enables AI-generated summaries and importance ranking
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Time zone for the daily briefing
TIMEZONE=Asia/Kolkata
DELIVERY_HOUR=7
DELIVERY_MINUTE=0

# Maximum stories to include in the daily briefing
MAX_STORIES=25
LOOKBACK_HOURS=30
